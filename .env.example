# Samvidhan Saral — environment example.
#
# Nothing here is required to run the application: the site reads the SQLite
# database built by `npm run data:build` and needs no keys, no accounts and no
# network access.  The variables below matter only for the optional PostgreSQL /
# Supabase deployment described in data/unified/database_schema.sql, and none of
# them should ever be committed with a real value.

# --- local database (optional) ------------------------------------------------
# Where the SQLite database lives.  Default: data/samvidhan.db beside the app
SAMVIDHAN_DB=/absolute/path/to/data/samvidhan.db

# --- optional PostgreSQL / Supabase deployment --------------------------------
# Connection string for the target database.  Use the pooled connection string
# for a serverless deployment and the direct one for loading the CSVs.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase project settings (only if you load the CSVs into Supabase).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# Service-role key: server-side only.  Never expose it to the browser and never
# commit it.
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# --- optional embeddings ------------------------------------------------------
# The offline subject-vector index (tf-idf) needs no model.  If you choose to add
# neural embeddings on top of it in PostgreSQL/pgvector, put the model name and
# key for *your* provider here; this project ships no embeddings and no key.
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
