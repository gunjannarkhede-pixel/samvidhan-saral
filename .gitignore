# dependencies and build output — regenerated by `npm install` and `npm run build`
node_modules/
.next/
out/
build/

# intermediate derivations of the pipeline; `pipeline/run_all.sh` rebuilds them.
# data/samvidhan.db IS committed — a deployment that omits it cannot answer a
# single question.
data/unified/
data/build/
__pycache__/
*.pyc

# SQLite's write-ahead log is folded into the database by `npm run build`
data/*.db-wal
data/*.db-shm

# local environment
.env.local
.DS_Store
